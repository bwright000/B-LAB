+// ggml_compute_forward_inkling_mix (reference: rms_norm each state, softmax(scale * <state, query>), weighted sum)
+
+void ggml_compute_forward_inkling_mix(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * cur   = dst->src[0];
+    const ggml_tensor * query = dst->src[1];
+    const ggml_tensor * stack = dst->src[2];
+
+    const int64_t n_embd   = cur->ne[0];
+    const int64_t n_tokens = cur->ne[1];
+    const int64_t n_q      = query->ne[1];
+    const int64_t n_blocks = stack ? stack->ne[1] : 0;
+    const int64_t n_states = n_blocks + 1;
+
+    const float eps   = ggml_get_op_params_f32(dst, 0);
+    const float scale = ggml_get_op_params_f32(dst, 1);
+
+    std::vector<const float *> states(n_states);
+    std::vector<float>         inv(n_states);
+    std::vector<float>         p(n_states);
+
+    for (int64_t t = params->ith; t < n_tokens; t += params->nth) {
+        for (int64_t j = 0; j < n_blocks; ++j) {
+            states[j] = (const float *) ((const char *) stack->data + j*stack->nb[1] + t*stack->nb[2]);
+        }
+        states[n_blocks] = (const float *) ((const char *) cur->data + t*cur->nb[1]);
+
+        for (int64_t j = 0; j < n_states; ++j) {
+            ggml_float ss = 0.0;
+            for (int64_t e = 0; e < n_embd; ++e) {
+                ss += (ggml_float) states[j][e] * states[j][e];
+            }
+            inv[j] = 1.0f/sqrtf((float) (ss/n_embd) + eps);
+        }
+
+        for (int64_t i = 0; i < n_q; ++i) {
+            const float * q = (const float *) ((const char *) query->data + i*query->nb[1]);
+            float max = -INFINITY;
+            for (int64_t j = 0; j < n_states; ++j) {
+                ggml_float d = 0.0;
+                for (int64_t e = 0; e < n_embd; ++e) {
+                    d += (ggml_float) states[j][e] * q[e];
+                }
+                p[j] = scale * inv[j] * (float) d;
+                max  = std::max(max, p[j]);
+            }
+            float sum = 0.0f;
+            for (int64_t j = 0; j < n_states; ++j) {
+                p[j] = expf(p[j] - max);
+                sum += p[j];
+            }
+            float * out = (float *) ((char *) dst->data + i*dst->nb[1] + t*dst->nb[2]);
+            for (int64_t e = 0; e < n_embd; ++e) {
+                float acc = 0.0f;
+                for (int64_t j = 0; j < n_states; ++j) {
+                    acc += (p[j]/sum) * inv[j] * states[j][e];
+                }
+                out[e] = acc;
+            }
+        }
+    }
+}
