diff --git a/ggml/src/ggml-cuda/inkling-fused.cu b/ggml/src/ggml-cuda/inkling-fused.cu
new file mode 100644
index 000000000..822b393aa
--- /dev/null
+++ b/ggml/src/ggml-cuda/inkling-fused.cu
@@ -0,0 +1,894 @@
+#include "inkling-fused.cuh"
+#include "ssm-conv.cuh"
+#include "../ggml-impl.h"
+
+static bool inkling_is_view_op(enum ggml_op op) {
+    return op == GGML_OP_VIEW || op == GGML_OP_RESHAPE || op == GGML_OP_PERMUTE || op == GGML_OP_TRANSPOSE;
+}
+
+static bool inkling_overlaps(const ggml_tensor * a, const ggml_tensor * c) {
+    const char * a0 = (const char *) a->data; const char * a1 = a0 + ggml_nbytes(a);
+    const char * c0 = (const char *) c->data; const char * c1 = c0 + ggml_nbytes(c);
+    return a0 < c1 && c0 < a1;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// GGML_OP_INKLING_MIX: depth attention in one kernel (replaces concat, rms_norm, repeat, transpose+cont, 2 matmuls, softmax)
+// One block per token. Pass 1: per state, sum of squares and the dot products with every query (one sweep, one block
+// reduction). Then a softmax per query. Pass 2: out_i = sum_j (p_ij * inv_rms_j) * state_j.
+// ---------------------------------------------------------------------------------------------------------------------
+#define INKLING_MIX_MAX_STATES 32
+#define INKLING_MIX_MAX_Q      4
+#define INKLING_MIX_THREADS    512   // generic path: 16 warps, pass 1 gives each warp its own states
+#define INKLING_MIX_FAST_THREADS 256 // fast path (<= 16 states)
+
+static __global__ void inkling_mix_f32(
+        const float * cur, const float * query, const float * stack, float * dst,
+        const int n_embd, const int n_q, const int n_blocks,
+        const int64_t cur_nb1, const int64_t q_nb1, const int64_t st_nb1, const int64_t st_nb2,
+        const int64_t d_nb1, const int64_t d_nb2, const float eps, const float scale) {
+    const int t = blockIdx.x;
+    const int n_states = n_blocks + 1;
+
+    __shared__ float inv[INKLING_MIX_MAX_STATES];
+    __shared__ float w[INKLING_MIX_MAX_Q][INKLING_MIX_MAX_STATES];   // scores, then p_ij * inv_j
+
+    auto state = [&](int j) -> const float * {
+        return j < n_blocks ? (const float *) ((const char *) stack + j*st_nb1 + t*st_nb2)
+                            : (const float *) ((const char *) cur + t*cur_nb1);
+    };
+
+    const int warp    = threadIdx.x / WARP_SIZE;
+    const int lane    = threadIdx.x % WARP_SIZE;
+    const int n_warps = blockDim.x / WARP_SIZE;
+
+    // pass 1: one warp per state (warp-level reductions only, all states in parallel)
+    for (int j = warp; j < n_states; j += n_warps) {
+        const float * s = state(j);
+        float acc[INKLING_MIX_MAX_Q + 1] = { 0.0f };
+        for (int e = lane; e < n_embd; e += WARP_SIZE) {
+            const float v = s[e];
+            acc[0] += v*v;
+#pragma unroll
+            for (int i = 0; i < INKLING_MIX_MAX_Q; ++i) {
+                if (i < n_q) {
+                    acc[i + 1] += v * ((const float *) ((const char *) query + i*q_nb1))[e];
+                }
+            }
+        }
+#pragma unroll
+        for (int k = 0; k < INKLING_MIX_MAX_Q + 1; ++k) {
+            acc[k] = warp_reduce_sum(acc[k]);
+        }
+        if (lane == 0) {
+            const float r = rsqrtf(acc[0] / n_embd + eps);
+            inv[j] = r;
+#pragma unroll
+            for (int i = 0; i < INKLING_MIX_MAX_Q; ++i) {
+                if (i < n_q) {
+                    w[i][j] = scale * r * acc[i + 1];
+                }
+            }
+        }
+    }
+    __syncthreads();
+
+    // softmax over the states, one thread per query; fold the rms factor into the weights
+    if (threadIdx.x < n_q) {
+        const int i = threadIdx.x;
+        float max = -INFINITY;
+        for (int j = 0; j < n_states; ++j) {
+            max = fmaxf(max, w[i][j]);
+        }
+        float sum = 0.0f;
+        for (int j = 0; j < n_states; ++j) {
+            w[i][j] = expf(w[i][j] - max);
+            sum += w[i][j];
+        }
+        for (int j = 0; j < n_states; ++j) {
+            w[i][j] = w[i][j] / sum * inv[j];
+        }
+    }
+    __syncthreads();
+
+    for (int e = threadIdx.x; e < n_embd; e += blockDim.x) {
+        float acc[INKLING_MIX_MAX_Q] = { 0.0f };
+        for (int j = 0; j < n_states; ++j) {
+            const float v = state(j)[e];
+#pragma unroll
+            for (int i = 0; i < INKLING_MIX_MAX_Q; ++i) {
+                acc[i] += w[i][j] * v;
+            }
+        }
+        for (int i = 0; i < n_q; ++i) {
+            ((float *) ((char *) dst + i*d_nb1 + t*d_nb2))[e] = acc[i];
+        }
+    }
+}
+
+// Fast path for up to MAXS states: every thread accumulates its slice of ALL states' sums of squares and query dots in
+// registers (many independent loads in flight), then a single combined block reduction. Decode runs one block per
+// token, so this kernel is latency-bound: maximise memory-level parallelism, minimise sequential sync rounds.
+template <int MAXS>
+static __global__ void inkling_mix_fast_f32(
+        const float * cur, const float * query, const float * stack, float * dst,
+        const int n_embd, const int n_q, const int n_blocks,
+        const int64_t cur_nb1, const int64_t q_nb1, const int64_t st_nb1, const int64_t st_nb2,
+        const int64_t d_nb1, const int64_t d_nb2, const float eps, const float scale) {
+    constexpr int NV = MAXS * (INKLING_MIX_MAX_Q + 1);
+    const int t = blockIdx.x;
+    const int n_states = n_blocks + 1;
+
+    __shared__ float red[INKLING_MIX_FAST_THREADS / WARP_SIZE][NV];
+    __shared__ float inv[MAXS];
+    __shared__ float w[INKLING_MIX_MAX_Q][MAXS];
+
+    const float * sp[MAXS];
+#pragma unroll
+    for (int j = 0; j < MAXS; ++j) {
+        sp[j] = j < n_blocks ? (const float *) ((const char *) stack + j*st_nb1 + t*st_nb2)
+                             : (const float *) ((const char *) cur + t*cur_nb1);
+    }
+
+    float acc[NV];
+#pragma unroll
+    for (int k = 0; k < NV; ++k) {
+        acc[k] = 0.0f;
+    }
+    for (int e = threadIdx.x; e < n_embd; e += blockDim.x) {
+        float q[INKLING_MIX_MAX_Q];
+#pragma unroll
+        for (int i = 0; i < INKLING_MIX_MAX_Q; ++i) {
+            q[i] = i < n_q ? ((const float *) ((const char *) query + i*q_nb1))[e] : 0.0f;
+        }
+#pragma unroll
+        for (int j = 0; j < MAXS; ++j) {
+            if (j < n_states) {
+                const float v = sp[j][e];
+                acc[j*(INKLING_MIX_MAX_Q + 1)] += v*v;
+#pragma unroll
+                for (int i = 0; i < INKLING_MIX_MAX_Q; ++i) {
+                    acc[j*(INKLING_MIX_MAX_Q + 1) + 1 + i] += v*q[i];
+                }
+            }
+        }
+    }
+
+    const int warp = threadIdx.x / WARP_SIZE;
+    const int lane = threadIdx.x % WARP_SIZE;
+#pragma unroll
+    for (int k = 0; k < NV; ++k) {
+        acc[k] = warp_reduce_sum(acc[k]);
+    }
+    if (lane == 0) {
+#pragma unroll
+        for (int k = 0; k < NV; ++k) {
+            red[warp][k] = acc[k];
+        }
+    }
+    __syncthreads();
+
+    // one thread per state: finish the reduction, rms factor and scores
+    if (threadIdx.x < n_states) {
+        const int j = threadIdx.x;
+        float tot[INKLING_MIX_MAX_Q + 1] = { 0.0f };
+        for (int wi = 0; wi < (int) (blockDim.x / WARP_SIZE); ++wi) {
+#pragma unroll
+            for (int k = 0; k < INKLING_MIX_MAX_Q + 1; ++k) {
+                tot[k] += red[wi][j*(INKLING_MIX_MAX_Q + 1) + k];
+            }
+        }
+        const float r = rsqrtf(tot[0] / n_embd + eps);
+        inv[j] = r;
+#pragma unroll
+        for (int i = 0; i < INKLING_MIX_MAX_Q; ++i) {
+            if (i < n_q) {
+                w[i][j] = scale * r * tot[i + 1];
+            }
+        }
+    }
+    __syncthreads();
+
+    if (threadIdx.x < n_q) {
+        const int i = threadIdx.x;
+        float max = -INFINITY;
+        for (int j = 0; j < n_states; ++j) {
+            max = fmaxf(max, w[i][j]);
+        }
+        float sum = 0.0f;
+        for (int j = 0; j < n_states; ++j) {
+            w[i][j] = expf(w[i][j] - max);
+            sum += w[i][j];
+        }
+        for (int j = 0; j < n_states; ++j) {
+            w[i][j] = w[i][j] / sum * inv[j];
+        }
+    }
+    __syncthreads();
+
+    for (int e = threadIdx.x; e < n_embd; e += blockDim.x) {
+        float o[INKLING_MIX_MAX_Q] = { 0.0f };
+#pragma unroll
+        for (int j = 0; j < MAXS; ++j) {
+            if (j < n_states) {
+                const float v = sp[j][e];
+#pragma unroll
+                for (int i = 0; i < INKLING_MIX_MAX_Q; ++i) {
+                    o[i] += w[i][j] * v;
+                }
+            }
+        }
+        for (int i = 0; i < n_q; ++i) {
+            ((float *) ((char *) dst + i*d_nb1 + t*d_nb2))[e] = o[i];
+        }
+    }
+}
+
+// Split path for few tokens (decode): the single-block-per-token kernel leaves 69 of 70 SMs idle at T=1.
+// Kernel A: grid (chunks, T), each block reduces its 256-element slice of every state into partial sums.
+// Kernel B: grid (chunks, T), each block sums the partials, does the (tiny, redundant) softmax, writes its slice.
+#define INKLING_MIX_CHUNK 256
+
+template <int MAXS>
+static __global__ void inkling_mix_partial_f32(
+        const float * cur, const float * query, const float * stack, float * partial,
+        const int n_embd, const int n_q, const int n_blocks,
+        const int64_t cur_nb1, const int64_t q_nb1, const int64_t st_nb1, const int64_t st_nb2) {
+    constexpr int NV = MAXS * (INKLING_MIX_MAX_Q + 1);
+    const int c = blockIdx.x, t = blockIdx.y, n_chunks = gridDim.x;
+    const int n_states = n_blocks + 1;
+    const int e = c*INKLING_MIX_CHUNK + threadIdx.x;
+
+    __shared__ float red[INKLING_MIX_CHUNK / WARP_SIZE][NV];
+
+    float acc[NV];
+#pragma unroll
+    for (int k = 0; k < NV; ++k) {
+        acc[k] = 0.0f;
+    }
+    if (e < n_embd) {
+        float q[INKLING_MIX_MAX_Q];
+#pragma unroll
+        for (int i = 0; i < INKLING_MIX_MAX_Q; ++i) {
+            q[i] = i < n_q ? ((const float *) ((const char *) query + i*q_nb1))[e] : 0.0f;
+        }
+#pragma unroll
+        for (int j = 0; j < MAXS; ++j) {
+            if (j < n_states) {
+                const float * s = j < n_blocks ? (const float *) ((const char *) stack + j*st_nb1 + t*st_nb2)
+                                               : (const float *) ((const char *) cur + t*cur_nb1);
+                const float v = s[e];
+                acc[j*(INKLING_MIX_MAX_Q + 1)] = v*v;
+#pragma unroll
+                for (int i = 0; i < INKLING_MIX_MAX_Q; ++i) {
+                    acc[j*(INKLING_MIX_MAX_Q + 1) + 1 + i] = v*q[i];
+                }
+            }
+        }
+    }
+    const int warp = threadIdx.x / WARP_SIZE, lane = threadIdx.x % WARP_SIZE;
+#pragma unroll
+    for (int k = 0; k < NV; ++k) {
+        acc[k] = warp_reduce_sum(acc[k]);
+    }
+    if (lane == 0) {
+#pragma unroll
+        for (int k = 0; k < NV; ++k) {
+            red[warp][k] = acc[k];
+        }
+    }
+    __syncthreads();
+    for (int k = threadIdx.x; k < n_states*(INKLING_MIX_MAX_Q + 1); k += blockDim.x) {
+        float s = 0.0f;
+        for (int wi = 0; wi < INKLING_MIX_CHUNK / WARP_SIZE; ++wi) {
+            s += red[wi][k];
+        }
+        partial[((int64_t) t*n_chunks + c)*NV + k] = s;
+    }
+}
+
+template <int MAXS>
+static __global__ void inkling_mix_finish_f32(
+        const float * cur, const float * stack, const float * partial, float * dst,
+        const int n_embd, const int n_q, const int n_blocks,
+        const int64_t cur_nb1, const int64_t st_nb1, const int64_t st_nb2,
+        const int64_t d_nb1, const int64_t d_nb2, const float eps, const float scale) {
+    constexpr int NV = MAXS * (INKLING_MIX_MAX_Q + 1);
+    const int c = blockIdx.x, t = blockIdx.y, n_chunks = gridDim.x;
+    const int n_states = n_blocks + 1;
+
+    __shared__ float tot[NV];
+    __shared__ float w[INKLING_MIX_MAX_Q][MAXS];
+
+    for (int k = threadIdx.x; k < n_states*(INKLING_MIX_MAX_Q + 1); k += blockDim.x) {
+        float s = 0.0f;
+        for (int ci = 0; ci < n_chunks; ++ci) {
+            s += partial[((int64_t) t*n_chunks + ci)*NV + k];
+        }
+        tot[k] = s;
+    }
+    __syncthreads();
+    if (threadIdx.x < n_q) {
+        const int i = threadIdx.x;
+        float sc[MAXS], r[MAXS];
+        float max = -INFINITY;
+        for (int j = 0; j < n_states; ++j) {
+            r[j]  = rsqrtf(tot[j*(INKLING_MIX_MAX_Q + 1)] / n_embd + eps);
+            sc[j] = scale * r[j] * tot[j*(INKLING_MIX_MAX_Q + 1) + 1 + i];
+            max   = fmaxf(max, sc[j]);
+        }
+        float sum = 0.0f;
+        for (int j = 0; j < n_states; ++j) {
+            sc[j] = expf(sc[j] - max);
+            sum  += sc[j];
+        }
+        for (int j = 0; j < n_states; ++j) {
+            w[i][j] = sc[j] / sum * r[j];
+        }
+    }
+    __syncthreads();
+
+    const int e = c*INKLING_MIX_CHUNK + threadIdx.x;
+    if (e < n_embd) {
+        float o[INKLING_MIX_MAX_Q] = { 0.0f };
+#pragma unroll
+        for (int j = 0; j < MAXS; ++j) {
+            if (j < n_states) {
+                const float * s = j < n_blocks ? (const float *) ((const char *) stack + j*st_nb1 + t*st_nb2)
+                                               : (const float *) ((const char *) cur + t*cur_nb1);
+                const float v = s[e];
+#pragma unroll
+                for (int i = 0; i < INKLING_MIX_MAX_Q; ++i) {
+                    o[i] += w[i][j] * v;
+                }
+            }
+        }
+        for (int i = 0; i < n_q; ++i) {
+            ((float *) ((char *) dst + i*d_nb1 + t*d_nb2))[e] = o[i];
+        }
+    }
+}
+
+template <int MAXS>
+static void inkling_mix_split_cuda(ggml_backend_cuda_context & ctx, const ggml_tensor * cur, const ggml_tensor * query,
+                                   const ggml_tensor * stack, ggml_tensor * dst) {
+    constexpr int NV = MAXS * (INKLING_MIX_MAX_Q + 1);
+    const int n_embd = (int) cur->ne[0], n_tokens = (int) cur->ne[1];
+    const int n_chunks = (n_embd + INKLING_MIX_CHUNK - 1) / INKLING_MIX_CHUNK;
+    ggml_cuda_pool_alloc<float> partial(ctx.pool(), (size_t) n_tokens*n_chunks*NV);
+    const dim3 grid(n_chunks, n_tokens, 1);
+    const float * st = stack ? (const float *) stack->data : nullptr;
+    inkling_mix_partial_f32<MAXS><<<grid, INKLING_MIX_CHUNK, 0, ctx.stream()>>>(
+        (const float *) cur->data, (const float *) query->data, st, partial.get(), n_embd, (int) query->ne[1],
+        stack ? (int) stack->ne[1] : 0, cur->nb[1], query->nb[1], stack ? stack->nb[1] : 0, stack ? stack->nb[2] : 0);
+    inkling_mix_finish_f32<MAXS><<<grid, INKLING_MIX_CHUNK, 0, ctx.stream()>>>(
+        (const float *) cur->data, st, partial.get(), (float *) dst->data, n_embd, (int) query->ne[1],
+        stack ? (int) stack->ne[1] : 0, cur->nb[1], stack ? stack->nb[1] : 0, stack ? stack->nb[2] : 0,
+        dst->nb[1], dst->nb[2], ggml_get_op_params_f32(dst, 0), ggml_get_op_params_f32(dst, 1));
+}
+
+bool ggml_cuda_inkling_mix_supported(const ggml_tensor * op) {
+    const ggml_tensor * cur = op->src[0], * query = op->src[1], * stack = op->src[2];
+    const int64_t n_states = (stack ? stack->ne[1] : 0) + 1;
+    return cur->type == GGML_TYPE_F32 && query->type == GGML_TYPE_F32 && (!stack || stack->type == GGML_TYPE_F32) &&
+           cur->nb[0] == sizeof(float) && query->nb[0] == sizeof(float) && (!stack || stack->nb[0] == sizeof(float)) &&
+           n_states <= INKLING_MIX_MAX_STATES && query->ne[1] <= INKLING_MIX_MAX_Q;
+}
+
+void ggml_cuda_op_inkling_mix(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * cur = dst->src[0], * query = dst->src[1], * stack = dst->src[2];
+    GGML_ASSERT(ggml_cuda_inkling_mix_supported(dst));
+    GGML_ASSERT(dst->nb[0] == sizeof(float));
+    const int n_states = (stack ? (int) stack->ne[1] : 0) + 1;
+    // few tokens (decode): spread each token over n_embd/256 blocks
+    static const bool no_split = getenv("GGML_CUDA_INKLING_MIX_NO_SPLIT") != nullptr;
+    if (!no_split && cur->ne[1] < 16) {
+        if (n_states <= 8)  { inkling_mix_split_cuda<8>(ctx, cur, query, stack, dst);  return; }
+        if (n_states <= 16) { inkling_mix_split_cuda<16>(ctx, cur, query, stack, dst); return; }
+    }
+#define INKLING_MIX_FAST_ARGS \
+        (const float *) cur->data, (const float *) query->data, stack ? (const float *) stack->data : nullptr, (float *) dst->data, \
+        (int) cur->ne[0], (int) query->ne[1], stack ? (int) stack->ne[1] : 0, \
+        cur->nb[1], query->nb[1], stack ? stack->nb[1] : 0, stack ? stack->nb[2] : 0, \
+        dst->nb[1], dst->nb[2], ggml_get_op_params_f32(dst, 0), ggml_get_op_params_f32(dst, 1)
+    if (n_states <= 8) {
+        inkling_mix_fast_f32<8><<<(unsigned) cur->ne[1], INKLING_MIX_FAST_THREADS, 0, ctx.stream()>>>(INKLING_MIX_FAST_ARGS);
+        return;
+    }
+    if (n_states <= 16) {
+        inkling_mix_fast_f32<16><<<(unsigned) cur->ne[1], INKLING_MIX_FAST_THREADS, 0, ctx.stream()>>>(INKLING_MIX_FAST_ARGS);
+        return;
+    }
+#undef INKLING_MIX_FAST_ARGS
+    inkling_mix_f32<<<(unsigned) cur->ne[1], INKLING_MIX_THREADS, 0, ctx.stream()>>>(
+        (const float *) cur->data, (const float *) query->data, stack ? (const float *) stack->data : nullptr, (float *) dst->data,
+        (int) cur->ne[0], (int) query->ne[1], stack ? (int) stack->ne[1] : 0,
+        cur->nb[1], query->nb[1], stack ? stack->nb[1] : 0, stack ? stack->nb[2] : 0,
+        dst->nb[1], dst->nb[2], ggml_get_op_params_f32(dst, 0), ggml_get_op_params_f32(dst, 1));
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// control() gates. Unfused (after each gate matvec m):
+//   forget: TANH(m) -> MUL(tanh, X) -> SUB(X, mul)      out = X - tanh(m)*X
+//   gain:   TANH(m) -> MUL(tanh, M) -> ADD(Y, mul)      out = Y + tanh(m)*M
+// Fused: one elementwise kernel, same expressions (bit-identical).
+// ---------------------------------------------------------------------------------------------------------------------
+// 2-D tensors [ne0, ne1]; m and dst contiguous, other/base may have a row stride (views of the mix output)
+static __global__ void inkling_tanh_gate_f32(const float * m, const char * other, const char * base, float * dst,
+                                             const int64_t ne0, const int64_t n, const int64_t o_nb1, const int64_t b_nb1,
+                                             const bool is_sub) {
+    const int64_t i = int64_t(blockIdx.x)*blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+    const int64_t i0 = i % ne0, i1 = i / ne0;
+    const float o = *(const float *) (other + i1*o_nb1 + i0*sizeof(float));
+    const float b = *(const float *) (base  + i1*b_nb1 + i0*sizeof(float));
+    const float t = tanhf(m[i]) * o;
+    dst[i] = is_sub ? b - t : b + t;
+}
+
+int ggml_cuda_try_fuse_inkling_tanh_gate(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
+    const ggml_tensor * th = cgraph->nodes[i];
+    if (th->op != GGML_OP_UNARY || ggml_get_unary_op(th) != GGML_UNARY_OP_TANH || i + 2 >= cgraph->n_nodes) {
+        return 0;
+    }
+    const ggml_tensor * mul = cgraph->nodes[i + 1];
+    const ggml_tensor * fin = cgraph->nodes[i + 2];
+    if (mul->op != GGML_OP_MUL || (fin->op != GGML_OP_SUB && fin->op != GGML_OP_ADD)) {
+        return 0;
+    }
+    const enum ggml_op ops[3] = { GGML_OP_UNARY, GGML_OP_MUL, fin->op };
+    const int out_idx = i + 2;
+    if (!ggml_can_fuse_subgraph(cgraph, i, 3, ops, &out_idx, 1)) {
+        return 0;
+    }
+    const ggml_tensor * other = mul->src[0] == th ? mul->src[1] : (mul->src[1] == th ? mul->src[0] : nullptr);
+    if (!other || fin->src[1] != mul) {
+        return 0;
+    }
+    const bool is_sub = fin->op == GGML_OP_SUB;
+    const ggml_tensor * base = fin->src[0];
+    if (is_sub && base != other) {    // forget gate: X - tanh(m)*X
+        return 0;
+    }
+    const ggml_tensor * m = th->src[0];
+    for (const ggml_tensor * t : { m, other, base, th, mul, fin }) {
+        if (t->type != GGML_TYPE_F32 || !ggml_are_same_shape(t, fin) || t->ne[2] != 1 || t->ne[3] != 1 ||
+            t->nb[0] != sizeof(float)) {
+            return 0;
+        }
+    }
+    if (!ggml_is_contiguous(m) || !ggml_is_contiguous(fin)) {   // other/base may be row-strided views
+        return 0;
+    }
+    // elementwise: an exact in-place alias is fine, partial overlap is not
+    for (const ggml_tensor * t : { m, other, base }) {
+        if (inkling_overlaps(fin, t) && !(fin->data == t->data && fin->nb[1] == t->nb[1])) {
+            return 0;
+        }
+    }
+    const int64_t n = ggml_nelements(fin);
+    const int block = 256;
+    inkling_tanh_gate_f32<<<(n + block - 1)/block, block, 0, ctx.stream()>>>(
+        (const float *) m->data, (const char *) other->data, (const char *) base->data, (float *) fin->data,
+        fin->ne[0], n, other->nb[1], base->nb[1], is_sub);
+    return 2;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// control() second half, fully fused. Unfused (8 nodes):
+//   MUL_MAT(Wf, d) -> TANH -> MUL(.., X) -> SUB(X, ..) -> MUL_MAT(Wg, d) -> TANH -> MUL(.., M) -> ADD(sub, ..)
+//   out = (X - tanh(Wf d)*X) + tanh(Wg d)*M,  Wf/Wg [rank, n_embd] f32, d [rank, T]
+// One warp per output element computes both rank-length dots (coalesced row reads, warp reduction) and both gates.
+// Not bit-exact vs the matvec kernels (different summation order).
+// ---------------------------------------------------------------------------------------------------------------------
+static __global__ void inkling_control_gates_f32(
+        const float * wf, const float * wg, const float * d, const char * x, const char * msg, float * dst,
+        const int rank, const int n_embd, const int n_tokens,
+        const int64_t wf_nb1, const int64_t wg_nb1, const int64_t d_nb1, const int64_t x_nb1, const int64_t m_nb1, const int64_t dst_nb1) {
+    const int warp = (blockIdx.x*blockDim.x + threadIdx.x) / WARP_SIZE;
+    const int lane = threadIdx.x % WARP_SIZE;
+    if (warp >= n_embd*n_tokens) {
+        return;
+    }
+    const int e = warp % n_embd, t = warp / n_embd;
+    const float * rf = (const float *) ((const char *) wf + e*wf_nb1);
+    const float * rg = (const float *) ((const char *) wg + e*wg_nb1);
+    const float * dv = (const float *) ((const char *) d  + t*d_nb1);
+    float sf = 0.0f, sg = 0.0f;
+    for (int k = lane; k < rank; k += WARP_SIZE) {
+        const float dk = dv[k];
+        sf += rf[k] * dk;
+        sg += rg[k] * dk;
+    }
+    sf = warp_reduce_sum(sf);
+    sg = warp_reduce_sum(sg);
+    if (lane == 0) {
+        const float xv = *(const float *) (x   + t*x_nb1 + e*sizeof(float));
+        const float mv = *(const float *) (msg + t*m_nb1 + e*sizeof(float));
+        const float sub = xv - tanhf(sf) * xv;
+        ((float *) ((char *) dst + t*dst_nb1))[e] = sub + tanhf(sg) * mv;
+    }
+}
+
+int ggml_cuda_try_fuse_inkling_control_gates(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
+    static const enum ggml_op ops[8] = { GGML_OP_MUL_MAT, GGML_OP_UNARY, GGML_OP_MUL, GGML_OP_SUB,
+                                         GGML_OP_MUL_MAT, GGML_OP_UNARY, GGML_OP_MUL, GGML_OP_ADD };
+    const int out_idx = i + 7;
+    if (i + 7 >= cgraph->n_nodes || !ggml_can_fuse_subgraph(cgraph, i, 8, ops, &out_idx, 1)) {
+        return 0;
+    }
+    const ggml_tensor * const * n = cgraph->nodes + i;
+    if (ggml_get_unary_op(n[1]) != GGML_UNARY_OP_TANH || ggml_get_unary_op(n[5]) != GGML_UNARY_OP_TANH) {
+        return 0;
+    }
+    const ggml_tensor * mmf = n[0], * mmg = n[4], * sub = n[3], * add = n[7];
+    const ggml_tensor * d = mmf->src[1];
+    // data flow: tanh(mm), mul(tanh, X), sub(X, mul), tanh(mm2), mul(tanh2, M), add(sub, mul2), same d for both matmuls
+    if (n[1]->src[0] != mmf || n[5]->src[0] != mmg || mmg->src[1] != d) {
+        return 0;
+    }
+    const ggml_tensor * X = n[2]->src[0] == n[1] ? n[2]->src[1] : (n[2]->src[1] == n[1] ? n[2]->src[0] : nullptr);
+    const ggml_tensor * M = n[6]->src[0] == n[5] ? n[6]->src[1] : (n[6]->src[1] == n[5] ? n[6]->src[0] : nullptr);
+    if (!X || !M || sub->src[0] != X || sub->src[1] != n[2] || add->src[0] != sub || add->src[1] != n[6]) {
+        return 0;
+    }
+    const ggml_tensor * wf = mmf->src[0], * wg = mmg->src[0];
+    const int rank = (int) wf->ne[0], n_embd = (int) wf->ne[1], n_tokens = (int) d->ne[1];
+    // the kernel re-reads the weight rows per token: only a win for few tokens (decode); prompts keep the GEMM path
+    if (n_tokens > 8) {
+        return 0;
+    }
+    if (wf->type != GGML_TYPE_F32 || wg->type != GGML_TYPE_F32 || d->type != GGML_TYPE_F32 || X->type != GGML_TYPE_F32 ||
+        M->type != GGML_TYPE_F32 || add->type != GGML_TYPE_F32 || !ggml_are_same_shape(wf, wg) || d->ne[0] != rank ||
+        wf->nb[0] != sizeof(float) || wg->nb[0] != sizeof(float) || d->nb[0] != sizeof(float) || X->nb[0] != sizeof(float) ||
+        M->nb[0] != sizeof(float) || !ggml_is_contiguous(add) || X->ne[0] != n_embd || X->ne[1] != n_tokens ||
+        M->ne[0] != n_embd || M->ne[1] != n_tokens || d->ne[2] != 1 || X->ne[2] != 1 || M->ne[2] != 1 || wf->ne[2] != 1) {
+        return 0;
+    }
+    // each warp reads x, msg, d and writes one element: exact same-layout alias with x or msg is fine
+    for (const ggml_tensor * t : { X, M }) {
+        if (inkling_overlaps(add, t) && !(add->data == t->data && add->nb[1] == t->nb[1])) {
+            return 0;
+        }
+    }
+    if (inkling_overlaps(add, d) || inkling_overlaps(add, wf) || inkling_overlaps(add, wg)) {
+        return 0;
+    }
+    const int64_t n_warps = (int64_t) n_embd*n_tokens;
+    const int threads = 256;
+    const int64_t blocks = (n_warps*WARP_SIZE + threads - 1)/threads;
+    inkling_control_gates_f32<<<(unsigned) blocks, threads, 0, ctx.stream()>>>(
+        (const float *) wf->data, (const float *) wg->data, (const float *) d->data, (const char *) X->data, (const char *) M->data,
+        (float *) add->data, rank, n_embd, n_tokens, wf->nb[1], wg->nb[1], d->nb[1], X->nb[1], M->nb[1], add->nb[1]);
+    return 7;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// convolve() head. Unfused: x = CONCAT(past, cur^T, dim 0) -> [views] -> CPY(view(x, last n_cols columns), state cell).
+// Fused: one kernel writes x and the state cell (pure copies, bit-identical).
+// ---------------------------------------------------------------------------------------------------------------------
+static __global__ void inkling_concat_state_f32(
+        const char * src0, const char * src1, char * dst, char * cell,
+        const int64_t ne00, const int64_t ne0, const int64_t ne1, const int64_t ne2,
+        const size_t s0_nb0, const size_t s0_nb1, const size_t s0_nb2,
+        const size_t s1_nb0, const size_t s1_nb1, const size_t s1_nb2,
+        const size_t d_nb1, const size_t d_nb2,
+        const int64_t first_col, const int64_t n_cols, const int64_t cell_ne0, const size_t cell_nb1) {
+    const int64_t i = int64_t(blockIdx.x)*blockDim.x + threadIdx.x;
+    if (i >= ne0*ne1*ne2) {
+        return;
+    }
+    const int64_t i0 = i % ne0;
+    const int64_t i1 = (i / ne0) % ne1;
+    const int64_t i2 = i / (ne0*ne1);
+
+    const float v = i0 < ne00
+        ? *(const float *) (src0 + i0*s0_nb0 + i1*s0_nb1 + i2*s0_nb2)
+        : *(const float *) (src1 + (i0 - ne00)*s1_nb0 + i1*s1_nb1 + i2*s1_nb2);
+
+    *(float *) (dst + i0*sizeof(float) + i1*d_nb1 + i2*d_nb2) = v;
+
+    if (i0 >= first_col) {
+        // flat index in the copied view [n_cols, ne1, ne2], laid out into the 2-D cell [cell_ne0, n_seqs]
+        const int64_t e = (i0 - first_col) + n_cols*(i1 + ne1*i2);
+        *(float *) (cell + (e % cell_ne0)*sizeof(float) + (e / cell_ne0)*cell_nb1) = v;
+    }
+}
+
+// TEMP debug: INKLING_FUSE_DEBUG=1 prints why the concat/state matcher rejects (first 12 per process)
+static int inkling_reject(const ggml_cgraph * cgraph, int i, const char * why) {
+    static const bool dbg = getenv("INKLING_FUSE_DEBUG") != nullptr;
+    static int n = 0;
+    if (dbg && n < 12) {
+        n++;
+        fprintf(stderr, "inkling concat/state reject @%d: %s | next ops:", i, why);
+        for (int j = i + 1; j < cgraph->n_nodes && j <= i + 5; ++j) {
+            fprintf(stderr, " %s(%s)", ggml_op_name(cgraph->nodes[j]->op), cgraph->nodes[j]->name);
+        }
+        fprintf(stderr, "\n");
+    }
+    return 0;
+}
+
+int ggml_cuda_try_fuse_inkling_concat_state(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
+    const ggml_tensor * cat = cgraph->nodes[i];
+    if (cat->op != GGML_OP_CONCAT || ggml_get_op_params_i32(cat, 0) != 0 || cat->type != GGML_TYPE_F32) {
+        return 0;
+    }
+    // walk over view nodes to the CPY
+    int k = i + 1;
+    while (k < cgraph->n_nodes && k <= i + 4 && inkling_is_view_op(cgraph->nodes[k]->op)) {
+        k++;
+    }
+    if (k >= cgraph->n_nodes || k > i + 4) {
+        return inkling_reject(cgraph, i, "no CPY within 4 views");
+    }
+    const ggml_tensor * cpy  = cgraph->nodes[k];
+    if (cpy->op != GGML_OP_CPY) {
+        return inkling_reject(cgraph, i, "node after views is not CPY");
+    }
+    const ggml_tensor * last = cpy->src[0];
+    const ggml_tensor * cell = cpy->src[1];
+    if (last->view_src != cat || last->op != GGML_OP_VIEW || cpy->type != GGML_TYPE_F32 || cell->type != GGML_TYPE_F32 ||
+        cat->src[0]->type != GGML_TYPE_F32 || cat->src[1]->type != GGML_TYPE_F32) {
+        return inkling_reject(cgraph, i, "CPY src is not a VIEW of the CONCAT / types");
+    }
+    // every node between CONCAT and CPY must be a view that nothing outside reads at execution time (views have no kernels)
+    enum ggml_op ops[8];
+    for (int j = i; j <= k; ++j) {
+        ops[j - i] = cgraph->nodes[j]->op;
+    }
+    // outputs: x (CONCAT, read later by ssm_conv), the CPY, and the state-cell view (the CPY destination, a view of the
+    // persistent conv state outside the subgraph: we write through it, so it is an output, not an elided intermediate)
+    int outs[8] = { i, k };
+    int n_outs  = 2;
+    for (int j = i + 1; j < k; ++j) {
+        if (cgraph->nodes[j] == cell) {
+            outs[n_outs++] = j;
+        }
+    }
+    if (!ggml_can_fuse_subgraph(cgraph, i, k - i + 1, ops, outs, n_outs)) {
+        return inkling_reject(cgraph, i, "ggml_can_fuse_subgraph");
+    }
+    // `last` must be the trailing columns of a contiguous x, cell a 2-D view with contiguous rows
+    if (!ggml_is_contiguous(cat) || last->nb[1] != cat->nb[1] || last->nb[2] != cat->nb[2] ||
+        last->ne[1] != cat->ne[1] || last->ne[2] != cat->ne[2] || cell->nb[0] != sizeof(float) ||
+        ggml_nelements(cell) != ggml_nelements(last) || cell->ne[2] != 1 || cell->ne[3] != 1 || cat->ne[3] != 1) {
+        return inkling_reject(cgraph, i, "layout");
+    }
+    const int64_t first_col = last->view_offs / sizeof(float);
+    if (first_col * (int64_t) sizeof(float) != (int64_t) last->view_offs || first_col + last->ne[0] != cat->ne[0]) {
+        return inkling_reject(cgraph, i, "view offset");
+    }
+    // the cell (persistent state) must not overlap what the kernel reads
+    if (inkling_overlaps(cell, cat->src[0]) || inkling_overlaps(cell, cat->src[1]) ||
+        inkling_overlaps(cat, cat->src[0]) || inkling_overlaps(cat, cat->src[1])) {
+        return inkling_reject(cgraph, i, "overlap");
+    }
+
+    const ggml_tensor * s0 = cat->src[0];
+    const ggml_tensor * s1 = cat->src[1];
+    const int64_t n = ggml_nelements(cat);
+    const int block = 256;
+    inkling_concat_state_f32<<<(n + block - 1)/block, block, 0, ctx.stream()>>>(
+        (const char *) s0->data, (const char *) s1->data, (char *) cat->data, (char *) cell->data,
+        s0->ne[0], cat->ne[0], cat->ne[1], cat->ne[2],
+        s0->nb[0], s0->nb[1], s0->nb[2], s1->nb[0], s1->nb[1], s1->nb[2],
+        cat->nb[1], cat->nb[2], first_col, last->ne[0], cell->ne[0], cell->nb[1]);
+    return k - i;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// convolve() tail. Unfused: SSM_CONV -> RESHAPE -> ADD(res, conv) -> SCALE(s, b).
+// Fused: the ssm_conv kernel with an epilogue y = s*(res + conv) + b (same expressions, so bit-identical).
+// ---------------------------------------------------------------------------------------------------------------------
+int ggml_cuda_try_fuse_inkling_conv(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
+    static const enum ggml_op ops[] = { GGML_OP_SSM_CONV, GGML_OP_RESHAPE, GGML_OP_ADD, GGML_OP_SCALE };
+    const int out_idx = i + 3;
+    if (!ggml_can_fuse_subgraph(cgraph, i, 4, ops, &out_idx, 1)) {
+        return 0;
+    }
+    const ggml_tensor * conv = cgraph->nodes[i];
+    const ggml_tensor * resh = cgraph->nodes[i + 1];
+    const ggml_tensor * add  = cgraph->nodes[i + 2];
+    const ggml_tensor * scl  = cgraph->nodes[i + 3];
+
+    if (resh->src[0] != conv || scl->src[0] != add) {
+        return 0;
+    }
+    const ggml_tensor * res = add->src[1] == resh ? add->src[0] : (add->src[0] == resh ? add->src[1] : nullptr);
+    if (!res || !ggml_are_same_shape(res, resh) || !ggml_are_same_shape(add, scl)) {
+        return 0;
+    }
+    if (conv->type != GGML_TYPE_F32 || res->type != GGML_TYPE_F32 || scl->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(conv) || !ggml_is_contiguous(res) || !ggml_is_contiguous(scl) ||
+        conv->src[0]->ne[1] % 128 != 0) {
+        return 0;
+    }
+    // reads conv input/weights and res while writing scl: exact in-place over res is fine (read then write per element)
+    if (inkling_overlaps(scl, conv->src[0]) || inkling_overlaps(scl, conv->src[1]) ||
+        (inkling_overlaps(scl, res) && scl->data != res->data)) {
+        return 0;
+    }
+
+    // optional trailing residual ADD (attention / FFN output joining the residual stream): 5 nodes -> 1 kernel
+    static const enum ggml_op ops5[] = { GGML_OP_SSM_CONV, GGML_OP_RESHAPE, GGML_OP_ADD, GGML_OP_SCALE, GGML_OP_ADD };
+    const int out5 = i + 4;
+    if (i + 4 < cgraph->n_nodes && ggml_can_fuse_subgraph(cgraph, i, 5, ops5, &out5, 1)) {
+        const ggml_tensor * add2 = cgraph->nodes[i + 4];
+        const ggml_tensor * res2 = add2->src[1] == scl ? add2->src[0] : (add2->src[0] == scl ? add2->src[1] : nullptr);
+        if (res2 && res2->type == GGML_TYPE_F32 && add2->type == GGML_TYPE_F32 && ggml_is_contiguous(res2) &&
+            ggml_is_contiguous(add2) && ggml_are_same_shape(res2, scl) && ggml_are_same_shape(add2, scl) &&
+            !inkling_overlaps(add2, conv->src[0]) && !inkling_overlaps(add2, conv->src[1]) &&
+            !(inkling_overlaps(add2, res) && add2->data != res->data) &&
+            !(inkling_overlaps(add2, res2) && add2->data != res2->data)) {
+            ggml_cuda_op_ssm_conv_res_scale(ctx, conv, res, add2, ggml_get_op_params_f32(scl, 0), ggml_get_op_params_f32(scl, 1), res2);
+            return 4;
+        }
+    }
+
+    ggml_cuda_op_ssm_conv_res_scale(ctx, conv, res, scl, ggml_get_op_params_f32(scl, 0), ggml_get_op_params_f32(scl, 1));
+    return 3;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// L2 row clip
+//
+// Unfused graph (per row of ne0 elements, scale broadcast over rows of dims 2/3):
+//   [MUL(x, scale)] -> SQR -> SUM_ROWS -> SQRT -> SCALE(s, b) -> FILL(threshold) -> DIV(fill, scaled) -> CLAMP(lo, hi) -> MUL(y, clamp)
+//
+// The kernel reproduces every op's float expression and the SUM_ROWS reduction order (reduce_row_f32: 8-way strided
+// partial sums per thread, then block_reduce, same block size selection as sum_rows_f32_cuda) so the output is
+// bit-identical to the unfused graph.
+// ---------------------------------------------------------------------------------------------------------------------
+
+// (has_scale is a runtime flag, not a template parameter: nvcc+MSVC fail on templated kernels with restrict params)
+static __global__ void inkling_clip_f32(
+        const float * x, const float * scale, float * dst, const bool has_scale,
+        const int ncols, const int64_t scale_rows,
+        const float s, const float b, const float threshold, const float lo, const float hi) {
+    const int64_t row = blockIdx.x;
+    const int     col = threadIdx.x;
+
+    const float * xr = x   + row*ncols;
+    float       * dr = dst + row*ncols;
+    // the scale tensor is [ncols, scale_rows] and broadcasts over the higher dims of x
+    const float * sr = has_scale ? scale + (row % scale_rows)*ncols : nullptr;
+
+    // --- identical to reduce_row_f32, with the input element computed as SQR(MUL(x, scale)) ---
+    float     sum        = 0.0f;
+    const int num_unroll = 8;
+    float     temp[num_unroll];
+    float     sum_temp[num_unroll] = { 0.0f };
+
+    ggml_cuda_pdl_sync();
+    for (int i = col; i < ncols;) {
+        for (int j = 0; j < num_unroll; ++j) {
+            if (i < ncols) {
+                const float y = has_scale ? xr[i] * sr[i] : xr[i];
+                temp[j] = y * y;
+            } else {
+                temp[j] = 0;
+            }
+            i += blockDim.x;
+        }
+        for (int j = 0; j < num_unroll; ++j) {
+            sum_temp[j] += temp[j];
+        }
+    }
+    for (int j = 0; j < num_unroll; ++j) {
+        sum += sum_temp[j];
+    }
+
+    __shared__ float shared_vals[32];
+    sum = block_reduce<block_reduce_method::SUM>(sum, shared_vals);   // every thread gets the row sum
+
+    // --- SQRT, SCALE, FILL/DIV, CLAMP: same expressions as the unfused kernels ---
+    const float norm   = sqrtf(sum);
+    const float scaled = s * norm + b;
+    const float factor = fminf(fmaxf(threshold / scaled, lo), hi);
+
+    // --- final MUL(y, factor) ---
+    for (int i = col; i < ncols; i += blockDim.x) {
+        const float y = has_scale ? xr[i] * sr[i] : xr[i];
+        dr[i] = y * factor;
+    }
+}
+
+int ggml_cuda_try_fuse_inkling_clip(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
+    static const enum ggml_op ops_scaled[]   = { GGML_OP_MUL, GGML_OP_SQR, GGML_OP_SUM_ROWS, GGML_OP_SQRT, GGML_OP_SCALE,
+                                                 GGML_OP_FILL, GGML_OP_DIV, GGML_OP_CLAMP, GGML_OP_MUL };
+    static const enum ggml_op ops_unscaled[] = { GGML_OP_SQR, GGML_OP_SUM_ROWS, GGML_OP_SQRT, GGML_OP_SCALE,
+                                                 GGML_OP_FILL, GGML_OP_DIV, GGML_OP_CLAMP, GGML_OP_MUL };
+
+    const ggml_tensor * first = cgraph->nodes[i];
+    bool has_scale;
+    if (first->op == GGML_OP_MUL) {
+        has_scale = true;
+    } else if (first->op == GGML_OP_SQR) {
+        has_scale = false;
+    } else {
+        return 0;
+    }
+
+    const int             n_ops = has_scale ? 9 : 8;
+    const enum ggml_op  * ops   = has_scale ? ops_scaled : ops_unscaled;
+    const int             out   = i + n_ops - 1;
+
+    // op types in order, intermediates used only inside the chain
+    if (!ggml_can_fuse_subgraph(cgraph, i, n_ops, ops, &out, 1)) {
+        return 0;
+    }
+
+    const int o = has_scale ? 1 : 0;   // offset of SQR
+    const ggml_tensor * mul0  = has_scale ? cgraph->nodes[i] : nullptr;
+    const ggml_tensor * sqr   = cgraph->nodes[i + o + 0];
+    const ggml_tensor * sum   = cgraph->nodes[i + o + 1];
+    const ggml_tensor * sqrt_ = cgraph->nodes[i + o + 2];
+    const ggml_tensor * scl   = cgraph->nodes[i + o + 3];
+    const ggml_tensor * fill  = cgraph->nodes[i + o + 4];
+    const ggml_tensor * div   = cgraph->nodes[i + o + 5];
+    const ggml_tensor * clamp = cgraph->nodes[i + o + 6];
+    const ggml_tensor * mul1  = cgraph->nodes[i + o + 7];
+
+    // y is the MUL output (scaled) or the raw input (unscaled)
+    const ggml_tensor * y = has_scale ? mul0 : sqr->src[0];
+
+    // exact data flow of clip()
+    if (sqr->src[0] != y || sum->src[0] != sqr || sqrt_->src[0] != sum || scl->src[0] != sqrt_ ||
+        fill->src[0] != scl || div->src[0] != fill || div->src[1] != scl || clamp->src[0] != div ||
+        mul1->src[0] != y || mul1->src[1] != clamp) {
+        return 0;
+    }
+
+    const ggml_tensor * x     = has_scale ? mul0->src[0] : y;
+    const ggml_tensor * scale = has_scale ? mul0->src[1] : nullptr;
+
+    // f32, contiguous rows, and a scale that broadcasts only over dims 2 and 3
+    for (const ggml_tensor * t : { x, mul1, sqr }) {
+        if (t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t)) {
+            return 0;
+        }
+    }
+    if (!ggml_are_same_shape(x, mul1) || sum->ne[0] != 1) {
+        return 0;
+    }
+    if (scale && (scale->type != GGML_TYPE_F32 || !ggml_is_contiguous(scale) || scale->ne[0] != x->ne[0] ||
+                  scale->ne[1] != x->ne[1] || scale->ne[2] != 1 || scale->ne[3] != 1)) {
+        return 0;
+    }
+
+    // the kernel reads x (and scale) while writing the output: an exact in-place alias is safe (each thread reads element
+    // i before writing it), any other overlap is not
+    auto overlaps = [](const ggml_tensor * a, const ggml_tensor * c) {
+        const char * a0 = (const char *) a->data; const char * a1 = a0 + ggml_nbytes(a);
+        const char * c0 = (const char *) c->data; const char * c1 = c0 + ggml_nbytes(c);
+        return a0 < c1 && c0 < a1;
+    };
+    if ((overlaps(mul1, x) && mul1->data != x->data) || (scale && overlaps(mul1, scale))) {
+        return 0;
+    }
+
+    const int     ncols = (int) x->ne[0];
+    const int64_t nrows = ggml_nrows(x);
+
+    const float s         = ggml_get_op_params_f32(scl, 0);
+    const float b         = ggml_get_op_params_f32(scl, 1);
+    const float threshold = ggml_get_op_params_f32(fill, 0);
+    const float lo        = ggml_get_op_params_f32(clamp, 0);
+    const float hi        = ggml_get_op_params_f32(clamp, 1);
+
+    // same block size as sum_rows_f32_cuda, so the reduction tree (and the result) is identical
+    const int  nsm        = ggml_cuda_info().devices[ggml_cuda_get_device()].nsm;
+    const dim3 block_dims((nrows / nsm) < 2 ? 512 : (ncols < 1024 ? 32 : 128), 1, 1);
+    const dim3 block_nums((unsigned) nrows, 1, 1);
+
